{
  "name": "roykung.com",
  "type": "module",
  "version": "1.3.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node --test scripts/smoke-test.mjs",
    "prepare": "husky",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.95.0"
  },
  "license": "MIT",
  "engines": {
    "node": "^24"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,jsonc,md,yml,yaml,css}": [
      "oxfmt"
    ],
    "*.astro": [
      "prettier --write"
    ]
  }
}
