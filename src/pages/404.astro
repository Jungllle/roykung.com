---
import Layout from '../layouts/Layout.astro';
---

<Layout title="找不到頁面" description="這個頁面不存在。">
  <div class="mx-auto max-w-3xl py-16 text-center">
    <p class="text-sm font-medium uppercase tracking-wide text-gray-400">404</p>
    <h1
      class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
    >
      找不到這個頁面
    </h1>
    <p class="mt-4 text-base text-gray-500">
      你要找的頁面可能已經搬走或不存在。
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center text-sm font-medium text-blue-600 transition-colors hover:text-blue-800"
    >
      回到首頁
    </a>
  </div>
</Layout>
